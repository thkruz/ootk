/**
 * This is the tsconfig extension that is used by the IDE.
 */
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2022",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "strictNullChecks": true,
  },
  "include": [
    "./src/**/*.ts",
    "./test/**/*.ts"
  ],
  // test/integration has its own tsconfig.json that resolves "ootk" to the built dist
  "exclude": [
    "./test/integration/**"
  ],
  "filesGlob": [
    "./src/**/*.ts",
    "./test/**/*.ts"
  ],
}