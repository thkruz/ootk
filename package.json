{
  "name": "ootk",
  "version": "6.0.0-rc.5",
  "type": "module",
  "module": "dist/main.js",
  "description": "Orbital Object Toolkit including Multiple Propagators, Initial Orbit Determination, and Maneuver Calculations.",
  "scripts": {
    "build": "npm run clean && npx tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
    "clean": "node ./scripts/cleanup.mjs",
    "circular": "madge --circular --extensions ts src/main.ts",
    "circular:image": "madge --circular --image circular-deps.svg --extensions ts src/main.ts",
    "lint": "npx eslint src",
    "lint:fix": "npx eslint src --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run build && vitest run --config test/integration/vitest.config.mts",
    "test:integration:only": "vitest run --config test/integration/vitest.config.mts",
    "test:all": "npm run test && npm run test:integration",
    "version": "npm run build && auto-changelog && git add CHANGELOG.md"
  },
  "main": "dist/main.js",
  "typings": "dist/main.d.ts",
  "repository": {
    "type": "git",
    "url": "git://github.com/thkruz/ootk"
  },
  "keywords": [
    "sgp4",
    "orbit",
    "toolkit",
    "space",
    "satellite",
    "radar",
    "iod"
  ],
  "author": "Theodore Kruczek <theodore.kruczek@gmail.com> (https://github.com/ootk/)",
  "license": "APGL-3.0",
  "bugs": {
    "url": "https://github.com/thkruz/ootk/issues"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "auto-changelog": "^2.5.0",
    "eslint": "^9.39.1",
    "fix-esm-import-path": "^1.10.3",
    "madge": "^8.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "homepage": "https://github.com/thkruz/ootk",
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  }
}
